# ── WorkOS (must match the main app at luistchitue.com) ──────────────────
# Copy values from the main app's deployment. WORKOS_COOKIE_PASSWORD MUST be
# identical so this template can decrypt the shared session cookie.
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=at-least-32-chars-same-as-main-app
# Scope the cookie to the apex so .luistchitue.com is shared across subdomains.
# The MAIN app must also set this same value. For local dev, see notes below.
WORKOS_COOKIE_DOMAIN=.luistchitue.com
# The template never handles a WorkOS callback itself (main app owns the flow)
# but the authkit-nextjs middleware throws on boot if this is missing.
# Note: the lib reads this from the NEXT_PUBLIC_ var specifically, even though
# WORKOS_REDIRECT_URI is the documented name in places. Point at main app's callback.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://luistchitue.com/callback

# ── Main app URL (where this template sends users to sign in) ────────────
NEXT_PUBLIC_MAIN_APP_URL=https://luistchitue.com
# Public URL of THIS deployment. Used to build the return_to param.
NEXT_PUBLIC_TEMPLATE_URL=https://template01.luistchitue.com
# Marketplace product page for the Paywall CTA.
NEXT_PUBLIC_TEMPLATE_PRODUCT_URL=https://luistchitue.com/templates/template-01

# ── Neon (same DB as the main app) ───────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── Local dev notes ──────────────────────────────────────────────────────
# Cookie sharing across subdomains only works with a real registrable domain.
# For local SSO testing, add to your hosts file:
#   127.0.0.1 local.luistchitue.com template01.local.luistchitue.com
# Then run main app on local.luistchitue.com:3000 and template on
# template01.local.luistchitue.com:3001, set WORKOS_COOKIE_DOMAIN=.local.luistchitue.com.
